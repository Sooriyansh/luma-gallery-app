<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurface" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/search_toolbar" android:layout_width="match_parent"
        android:layout_height="64dp" android:paddingHorizontal="8dp" app:title="Search library" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp" android:hint="@string/search"
        app:boxBackgroundMode="filled" app:boxCornerRadiusBottomEnd="22dp" app:boxCornerRadiusBottomStart="22dp"
        app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusTopStart="22dp" app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/query" android:layout_width="match_parent"
            android:layout_height="56dp" android:imeOptions="actionSearch" android:inputType="text" android:minHeight="48dp" />
    </com.google.android.material.textfield.TextInputLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/search_filters" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:paddingVertical="8dp"
            app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/filter_all" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="48dp" android:checked="true" android:text="All" />
            <com.google.android.material.chip.Chip android:id="@+id/filter_screenshots" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="Screenshots" />
            <com.google.android.material.chip.Chip android:id="@+id/filter_downloads" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="Downloads" />
            <com.google.android.material.chip.Chip android:id="@+id/filter_ai" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="AI Generated" />
            <com.google.android.material.chip.Chip android:id="@+id/filter_edited" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="Edited" />
            <com.google.android.material.chip.Chip android:id="@+id/filter_favorites" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="Favorites" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/results" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:padding="4dp" android:paddingBottom="24dp" />
</LinearLayout>
