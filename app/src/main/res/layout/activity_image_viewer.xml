<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/black">
    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/image_pager" android:layout_width="match_parent"
        android:layout_height="match_parent" android:paddingTop="56dp" android:paddingBottom="72dp" />
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="@color/black_scrim"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar" app:menu="@menu/image_viewer_menu" />
    <HorizontalScrollView android:id="@+id/image_actions" android:layout_width="match_parent" android:layout_height="72dp"
        android:layout_gravity="bottom" android:background="@color/black_scrim" android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center"
            android:orientation="horizontal" android:paddingHorizontal="6dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/action_share" style="@style/Widget.G.Button.Viewer"
                android:layout_width="80dp" android:layout_height="match_parent" android:contentDescription="Share image"
                android:text="Share" app:icon="@drawable/ic_share" />
            <com.google.android.material.button.MaterialButton android:id="@+id/action_crop" style="@style/Widget.G.Button.Viewer"
                android:layout_width="80dp" android:layout_height="match_parent" android:contentDescription="Edit or crop image"
                android:text="Edit" app:icon="@drawable/ic_edit" />
            <com.google.android.material.button.MaterialButton android:id="@+id/action_ai" style="@style/Widget.G.Button.Viewer"
                android:layout_width="90dp" android:layout_height="match_parent" android:contentDescription="Scan image for AI"
                android:text="AI Scan" app:icon="@drawable/ic_ai_scan" />
            <com.google.android.material.button.MaterialButton android:id="@+id/action_favorite" style="@style/Widget.G.Button.Viewer"
                android:layout_width="86dp" android:layout_height="match_parent" android:contentDescription="Add image to favorites"
                android:text="Favorite" app:icon="@drawable/ic_favorite" />
            <com.google.android.material.button.MaterialButton android:id="@+id/action_rotate" style="@style/Widget.G.Button.Viewer"
                android:layout_width="80dp" android:layout_height="match_parent" android:contentDescription="Rotate image right"
                android:text="Rotate" app:icon="@drawable/ic_rotate" />
            <com.google.android.material.button.MaterialButton android:id="@+id/action_hide" style="@style/Widget.G.Button.Viewer"
                android:layout_width="80dp" android:layout_height="match_parent" android:contentDescription="Move image to Eye"
                android:text="Hide" app:icon="@drawable/ic_eye" />
            <com.google.android.material.button.MaterialButton android:id="@+id/action_delete" style="@style/Widget.G.Button.Viewer"
                android:layout_width="80dp" android:layout_height="match_parent" android:contentDescription="Move image to trash"
                android:text="Delete" android:textColor="#FFFFB4AB" app:icon="@drawable/ic_delete" app:iconTint="#FFFFB4AB" />
        </LinearLayout>
    </HorizontalScrollView>
</FrameLayout>
