<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/black">
    <androidx.media3.ui.PlayerView android:id="@+id/player_view" android:layout_width="match_parent" android:layout_height="match_parent" />
    <TextView android:id="@+id/error" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:padding="24dp" android:textColor="@android:color/white" android:visibility="gone" />
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/video_toolbar" android:layout_width="match_parent"
        android:layout_height="56dp" android:background="@color/black_scrim" android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:title="Video" app:menu="@menu/video_player_menu" />
    <HorizontalScrollView android:id="@+id/video_actions" android:layout_width="match_parent" android:layout_height="72dp"
        android:layout_gravity="bottom" android:background="@color/black_scrim" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="6dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/video_analysis" style="@style/Widget.G.Button.Viewer"
                android:layout_width="92dp" android:layout_height="match_parent" android:text="AI Scan" app:icon="@drawable/ic_ai_scan" />
            <com.google.android.material.button.MaterialButton android:id="@+id/video_hide" style="@style/Widget.G.Button.Viewer"
                android:layout_width="90dp" android:layout_height="match_parent" android:text="Hide" app:icon="@drawable/ic_eye" />
            <com.google.android.material.button.MaterialButton android:id="@+id/video_trim" style="@style/Widget.G.Button.Viewer"
                android:layout_width="90dp" android:layout_height="match_parent" android:text="Edit" app:icon="@drawable/ic_edit" />
            <com.google.android.material.button.MaterialButton android:id="@+id/video_rotate" style="@style/Widget.G.Button.Viewer"
                android:layout_width="90dp" android:layout_height="match_parent" android:text="Rotate" app:icon="@drawable/ic_rotate" />
            <com.google.android.material.button.MaterialButton android:id="@+id/video_delete" style="@style/Widget.G.Button.Viewer"
                android:layout_width="90dp" android:layout_height="match_parent" android:text="Delete" android:textColor="#FFFFB4AB"
                app:icon="@drawable/ic_delete" app:iconTint="#FFFFB4AB" />
        </LinearLayout>
    </HorizontalScrollView>
</FrameLayout>
